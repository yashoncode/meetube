    <string name="meetune_eq">MeeTune Equalizer</string>
    <string name="meetune_eq_sound">Sound</string>
    <string name="meetune_eq_off">Off</string>
    <string name="meetune_eq_note">Shapes MeeTune\'s songs inside the app, before they reach the phone. MeeTube videos keep their own sound.</string>
    <string name="meetune_eq_dynamic">Dynamic</string>
    <string name="meetune_eq_manual">Manual</string>
    <string name="meetune_eq_tone">Tone</string>
    <string name="meetune_eq_tone_readout">Tilt %1$s  ·  Mid %2$s</string>
    <string name="meetune_eq_tone_desc">Tone pad. Tilt %1$s, mid %2$s. Drag to change.</string>
    <string name="meetune_eq_broad">Broad</string>
    <string name="meetune_eq_focused">Focused</string>
    <string name="meetune_eq_tone_note_broad">Drag left for a warmer sound and right for a brighter one; down scoops the middle, up brings it forward. Broad moves wide stretches of the spectrum at once.</string>
    <string name="meetune_eq_tone_note_focused">Drag left for a warmer sound and right for a brighter one; down scoops the middle, up brings it forward. Focused moves only the far ends and a narrow middle.</string>
