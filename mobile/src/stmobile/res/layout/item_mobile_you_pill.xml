<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you page): a Library or Pinned row on the You tab, a full-width glass pill: bare icon,
     label, chevron. Wired in MobileBrowseActivity.youSectionRow(). -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_you_row_glass"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:glassCornerRadius="24dp"
    app:glassTint="@color/meetube_glass_button">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/mobile_you_row_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:tint="@color/mobile_color_on_surface" />

        <TextView
            android:id="@+id/mobile_you_row_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/mobile_color_on_surface" />

    </LinearLayout>

</com.newtube.mobile.ui.common.GlassView>
