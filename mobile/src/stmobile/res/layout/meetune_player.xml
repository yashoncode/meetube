<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUNE: the music look of the player (MeeTunePlayerSkin), over the whole watch page while a
     MeeTune song plays: the art full-bleed at the top fading out into its own blur, the song, a thick
     bar, the transport, the volume, and Lyrics / Cast / Up next. Text is white on the art's dark
     scrim in both themes, as the video player's is; the buttons are glowing glass over the art. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/meetune_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF141414"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <!-- What the glass buttons frost: the blurred art, its scrim and the art. -->
    <com.newtube.mobile.ui.common.GlassSource
        android:id="@+id/meetune_player_source"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
        android:id="@+id/meetune_player_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- The art's lower part fades out to nothing, so it melts into its own blur under the controls. -->
    <view
        class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$FadeImage"
        android:id="@+id/meetune_player_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    </com.newtube.mobile.ui.common.GlassSource>

    <!-- The song's moving cover (MeeTuneCanvas), muted and looping over the still one; the skin
         keeps it on the cover's place, size and motion every frame. -->
    <view
        class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$FadeFrame"
        android:id="@+id/meetune_player_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/meetune_player_canvas_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:shutter_background_color="@android:color/transparent"
            app:surface_type="texture_view"
            app:use_controller="false" />

    </view>

    <View
        android:id="@+id/meetune_player_handle"
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/meetune_handle" />

    <!-- Lyrics: the song small at the top, the synced lines under it down to the controls (or the
         whole page, a tap on the lines away). -->
    <LinearLayout
        android:id="@+id/meetune_player_lyrics_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/meetune_player_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/meetune_player_head_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/meetune_player_head_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="?attr/appFontMedium"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/meetune_player_head_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="15sp" />

                <include
                    layout="@layout/meetune_karaoke_chip"
                    android:theme="@style/ThemeOverlay.NewTube.PlayerChrome" />

            </LinearLayout>

            <com.newtube.mobile.ui.common.GlassView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                app:glassCornerRadius="999dp"
                app:glassTint="@color/meetune_player_glass">

                <ImageView
                    android:id="@+id/meetune_player_head_like"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_like"
                    android:padding="9dp"
                    android:src="@drawable/ic_meetune_heart" />

            </com.newtube.mobile.ui.common.GlassView>

            <com.newtube.mobile.ui.common.GlassView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="14dp"
                app:glassCornerRadius="999dp"
                app:glassTint="@color/meetune_player_glass">

                <ImageView
                    android:id="@+id/meetune_player_head_more"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_more"
                    android:padding="9dp"
                    android:src="@drawable/ic_meetune_more"
                    android:tint="@android:color/white" />

            </com.newtube.mobile.ui.common.GlassView>

        </LinearLayout>

        <view
            class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$LyricsScroll"
            android:id="@+id/meetune_player_lyrics_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="64dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/meetune_player_lyrics_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp" />

        </view>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/meetune_player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/meetune_player_format_space"
            android:visibility="invisible"
            android:text=" "
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/meetune_player_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/meetune_player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fadingEdgeLength="20dp"
                    android:requiresFadingEdge="horizontal"
                    android:fontFamily="?attr/appFontMedium"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/meetune_player_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="20sp" />

                <include
                    layout="@layout/meetune_karaoke_chip"
                    android:theme="@style/ThemeOverlay.NewTube.PlayerChrome" />

            </LinearLayout>

            <com.newtube.mobile.ui.common.GlassView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                app:glassCornerRadius="999dp"
                app:glassTint="@color/meetune_player_glass">

                <ImageView
                    android:id="@+id/meetune_player_like"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_like"
                    android:padding="9dp"
                    android:src="@drawable/ic_meetune_heart" />

            </com.newtube.mobile.ui.common.GlassView>

            <com.newtube.mobile.ui.common.GlassView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="14dp"
                app:glassCornerRadius="999dp"
                app:glassTint="@color/meetune_player_glass">

                <ImageView
                    android:id="@+id/meetune_player_more"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_more"
                    android:padding="9dp"
                    android:src="@drawable/ic_meetune_more" />

            </com.newtube.mobile.ui.common.GlassView>

        </LinearLayout>

        <!-- The line being sung, over the bar; tap for the lyrics. -->
        <LinearLayout
            android:id="@+id/meetune_player_line_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/meetune_player_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:minLines="2"
                android:alpha="0"
                android:shadowColor="#59FFFFFF"
                android:shadowRadius="14"
                android:textColor="#A6FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="#99FFFFFF" />

        </LinearLayout>

        <view
            class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$GlowSeek"
            android:id="@+id/meetune_player_seek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/meetune_seek"
            android:splitTrack="false"
            android:thumb="@android:color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meetune_player_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/meetune_player_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <view
                    class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$GlowIcon"
                    android:id="@+id/meetune_player_previous"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_back"
                    android:padding="16dp"
                    android:src="@drawable/ic_meetune_rewind" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <view
                    class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$GlowIcon"
                    android:id="@+id/meetune_player_play"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_play"
                    android:padding="20dp"
                    android:src="@drawable/ic_meetune_pause" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <view
                    class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$GlowIcon"
                    android:id="@+id/meetune_player_next"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meetune_queue"
                    android:padding="16dp"
                    android:src="@drawable/ic_meetune_forward" />

            </FrameLayout>

        </LinearLayout>

        <!-- Focus: a tap hides the volume and the song's pill, the controls settle lower and the
             sung line grows; another tap brings them back. -->
        <ImageView
            android:id="@+id/meetune_player_focus"
            android:layout_width="72dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/meetune_focus"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:src="@drawable/ic_meetune_focus"
            />

        <LinearLayout
            android:id="@+id/meetune_player_volume_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_volume_down"
                android:tint="#B3FFFFFF" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <view
                    class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$GlowSeek"
                    android:id="@+id/meetune_player_volume"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progressDrawable="@drawable/meetune_seek"
                    android:splitTrack="false"
                    android:thumb="@android:color/transparent" />

                <!-- The volume's level as it changes: a glass pill gliding over the bar's end. -->
                <com.newtube.mobile.ui.common.GlassView
                    android:id="@+id/meetune_player_volume_bubble"
                    android:layout_width="58dp"
                    android:layout_height="30dp"
                    android:alpha="0"
                    android:translationY="-36dp"
                    app:glassCornerRadius="999dp"
                    app:glassTint="@color/meetune_player_glass">

                    <TextView
                        android:id="@+id/meetune_player_volume_level"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </com.newtube.mobile.ui.common.GlassView>

            </FrameLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_volume_up"
                android:tint="#B3FFFFFF" />

        </LinearLayout>

        <!-- The song's pill: glowing bars that move while it plays, its format (an OPUS badge in
             the cover's colour, then 147 kbps · 48 kHz · Stereo) and a headset when one is connected. A tap shows where it
             plays (the speaker's or headset's name) for 10 s; another tap, the format again. -->
        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/meetune_player_info"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            app:glassCornerRadius="999dp"
            app:glassTint="#17FFFFFF">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:duplicateParentState="true"
                android:minWidth="0dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <view
                    class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$EqBars"
                    android:id="@+id/meetune_player_eq"
                    android:layout_width="14dp"
                    android:layout_height="14dp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/meetune_player_format_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/meetune_player_format"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:fontFamily="?attr/appFontMedium"
                            android:gravity="center"
                            android:letterSpacing="0.14"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="5dp"
                            android:textColor="#D9FFFFFF"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/meetune_player_format_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:fontFamily="?attr/appFontRegular"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="0.02"
                            android:singleLine="true"
                            android:textColor="#99FFFFFF"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/meetune_player_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:ellipsize="end"
                        android:fontFamily="?attr/appFontMedium"
                        android:maxLines="1"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:visibility="invisible" />

                </FrameLayout>

                <ImageView
                    android:id="@+id/meetune_player_headset"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_player_headphones"
                    android:tint="#99FFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

        </com.newtube.mobile.ui.common.GlassView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- MEETUNE(play mode): Autoplay, Shuffle, Repeat this song or stop after it, a tap each. -->
                <com.newtube.mobile.ui.common.GlassView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    app:glassCornerRadius="999dp"
                    app:glassTint="@color/meetune_player_glass">

                    <ImageView
                        android:id="@+id/meetune_player_mode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/meetune_mode_autoplay"
                        android:padding="12dp"
                        android:src="@drawable/ic_meetune_autoplay"
                        android:tint="#D9FFFFFF" />

                </com.newtube.mobile.ui.common.GlassView>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.newtube.mobile.ui.common.GlassView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    app:glassCornerRadius="999dp"
                    app:glassTint="@color/meetune_player_glass">

                    <ImageView
                        android:id="@+id/meetune_player_lyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/meetune_lyrics"
                        android:padding="12dp"
                        android:src="@drawable/ic_watch_lyrics"
                        android:tint="#D9FFFFFF" />

                </com.newtube.mobile.ui.common.GlassView>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.newtube.mobile.ui.common.GlassView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    app:glassCornerRadius="999dp"
                    app:glassTint="@color/meetune_player_glass">

                    <ImageView
                        android:id="@+id/meetune_player_cast"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/meetune_cast"
                        android:padding="12dp"
                        android:src="@drawable/ic_mobile_cast"
                        android:tint="#D9FFFFFF" />

                </com.newtube.mobile.ui.common.GlassView>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.newtube.mobile.ui.common.GlassView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    app:glassCornerRadius="999dp"
                    app:glassTint="@color/meetune_player_glass">

                    <ImageView
                        android:id="@+id/meetune_player_queue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/meetune_queue"
                        android:padding="12dp"
                        android:src="@drawable/ic_player_queue"
                        android:tint="#D9FFFFFF" />

                </com.newtube.mobile.ui.common.GlassView>

            </FrameLayout>

        </LinearLayout>


    </LinearLayout>

</FrameLayout>
