<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MEETUBE(app icon): Android 13+ shows the splash AppIcon.syncSplash remembered for the
         picked icon. This one is only for a launch with none remembered - the first one after an
         install or update, which clears it - and some splash implementations (vivo's) then show
         the application's icon, the default one, instead of the tapped alias's. So no icon: a
         plain splash once rather than the wrong icon. Android 12 (values-v31) can't remember a
         splash, so it keeps the alias's icon. -->
    <style name="Theme.MeeTube.Splash" parent="Theme.NewTube">
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
