<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you page): an Explore tile on the You tab, four to a line: a glass square, the icon
     over its name. Wired in MobileBrowseActivity.youSectionRow(). -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_you_row_glass"
    android:layout_width="0dp"
    android:layout_height="88dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:glassCornerRadius="22dp"
    app:glassTint="@color/meetube_glass_button">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/mobile_you_row_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:tint="@color/mobile_color_on_surface" />

        <TextView
            android:id="@+id/mobile_you_row_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="13sp" />

    </LinearLayout>

</com.newtube.mobile.ui.common.GlassView>
