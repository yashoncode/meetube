<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MEETUBE: focused = a raised glass key: a white body shading down, a gloss on its upper half and a light
         rim. BrowseHeaderItemPresenter tilts it in and sweeps a glint across it. -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#FFFFFFFF"
                        android:centerColor="#FFF2F5FA" android:endColor="#FFD3DAE5" />
                    <stroke android:width="1dp" android:color="#FFFFFFFF" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
            <item android:top="2dp" android:left="8dp" android:right="8dp" android:bottom="27dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#E6FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="25dp" android:topRightRadius="25dp"
                        android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- current section: quieter glass with the same gloss, so it reads as the same raised key, unlit -->
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="#38FFFFFF" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
            <item android:top="2dp" android:left="8dp" android:right="8dp" android:bottom="27dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="25dp" android:topRightRadius="25dp"
                        android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#06FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</selector>
