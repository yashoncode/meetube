<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass): a frosted tick box for multi-choice dialogs (Auto download's Channels and
     Playlists): see-through glass with a lit rim, a brighter frost and the check when ticked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="22dp" android:height="22dp" />
                    <corners android:radius="7dp" />
                    <solid android:color="@color/meetube_glass_selected" />
                    <stroke android:width="1dp" android:color="@color/meetube_glass_rim" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:drawable="@drawable/ic_mobile_check"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="22dp" android:height="22dp" />
            <corners android:radius="7dp" />
            <solid android:color="@color/meetube_glass_fill" />
            <stroke android:width="1dp" android:color="@color/meetube_glass_rim" />
        </shape>
    </item>
</selector>
