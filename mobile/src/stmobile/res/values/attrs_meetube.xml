<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MEETUBE(loader): the picked loader drawable (Widget.MeeTube.GlassSpinner, Widget.MeeTube.Loader). -->
    <attr name="meetubeLoader" format="reference" />
    <!-- MEETUBE(accent): the picked accent (ui.common.Accent), bright and a deeper one for a light page. -->
    <attr name="meetubeAccent" format="color" />
    <attr name="meetubeAccentDeep" format="color" />
    <!-- MEETUBE(youtube mode): video card corners and the bottom bar's shape; all 0 in
         ThemeOverlay.MeeTube.YouTubeMode (ui.common.YouTubeMode). -->
    <attr name="meetubeCardCorner" format="dimension" />
    <attr name="meetubeRowCorner" format="dimension" />
    <attr name="meetubeRelatedCorner" format="dimension" />
    <attr name="meetubeNavCorner" format="dimension" />
    <attr name="meetubeNavSideMargin" format="dimension" />
    <attr name="meetubeNavBottomMargin" format="dimension" />
    <attr name="meetubeNavMaxWidth" format="dimension" />
    <attr name="meetubeNavTint" format="color" />
    <attr name="meetubeNavItemBackground" format="reference" />
    <attr name="meetubeNavLiquid" format="boolean" />
    <!-- MEETUBE(glass): GlassView's shape and tint. -->
    <declare-styleable name="GlassView">
        <attr name="glassCornerRadius" format="dimension" />
        <attr name="glassTint" format="color" />
        <attr name="glassLiquid" format="boolean" />
        <!-- On a surface that is already glass (a frosted sheet): no backdrop of its own, and the
             tint stays see-through instead of the near-opaque no-backdrop fallback. -->
        <attr name="glassOnGlass" format="boolean" />
        <!-- MEETUBE(issue #118): the widest it grows; centre it with its layout gravity. -->
        <attr name="glassMaxWidth" format="dimension" />
        <!-- A flat bar's frost thins out to nothing over this much of its bottom (Settings' top bar). -->
        <attr name="glassFadeBottom" format="dimension" />
    </declare-styleable>
</resources>
