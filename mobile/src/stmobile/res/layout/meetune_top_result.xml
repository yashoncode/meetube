<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUNE: Search's top result - its cover big beside the name, then Play and Playlist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/meetune_top_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="6dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/meetune_art_card"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="@color/mobile_color_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/meetune_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/meetune_explicit" />

                <TextView
                    android:id="@+id/meetune_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="?attr/appFontMedium"
                    android:maxLines="2"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="22sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/meetune_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/meetune_row_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/meetune_more"
            android:padding="11dp"
            android:src="@drawable/ic_mobile_more_vert"
            android:tint="@color/mobile_color_on_surface" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetune_top_play"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="120dp"
            android:text="@string/meetune_play"
            android:textAllCaps="false"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_meetune_play"
            app:iconTint="@color/mobile_color_on_surface"
            app:strokeColor="@color/mobile_color_on_surface_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetune_top_playlist"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:minWidth="120dp"
            android:text="@string/meetune_playlist"
            android:textAllCaps="false"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_player_playlist_add"
            app:iconTint="@color/mobile_color_on_surface"
            app:strokeColor="@color/mobile_color_on_surface_secondary" />

    </LinearLayout>

</LinearLayout>
