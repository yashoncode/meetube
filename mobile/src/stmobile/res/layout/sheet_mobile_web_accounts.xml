<?xml version="1.0" encoding="utf-8"?>
<!--
  Web account picker (WebSignInSheet.pickAccount): which signed-in Google account live chat and
  likes use. Account rows (avatar, name, check), then Add / Sign out. A bottom sheet, so it gets
  the app's frosted glass like every other sheet. Rows are item_mobile_account_row /
  item_mobile_you_row, filled in code.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <TextView
            android:id="@+id/web_accounts_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/web_accounts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/mobile_color_divider" />

        <LinearLayout
            android:id="@+id/web_accounts_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
