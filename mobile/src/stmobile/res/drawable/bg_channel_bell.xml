<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(issue #239): the bell beside Subscribed: the subscribed pill's glass, round. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="4dp">
    <ripple android:color="?android:attr/colorControlHighlight">
        <item>
            <shape android:shape="oval">
                <solid android:color="@color/meetube_glass_fill" />
                <stroke android:width="0.5dp" android:color="@color/meetube_glass_stroke" />
            </shape>
        </item>
    </ripple>
</inset>
