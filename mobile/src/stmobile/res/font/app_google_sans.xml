<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(font): Google Sans, every weight (ui.common.AppFont). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/google_sans_regular"
        app:fontStyle="normal" app:fontWeight="400" app:font="@font/google_sans_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/google_sans_medium"
        app:fontStyle="normal" app:fontWeight="500" app:font="@font/google_sans_medium" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/google_sans_bold"
        app:fontStyle="normal" app:fontWeight="700" app:font="@font/google_sans_bold" />
</font-family>
