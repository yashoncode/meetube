<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass press): the comment actions and sort button: a 36dp pill lit on a press, inside a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="6dp" android:insetBottom="6dp">
    <selector android:enterFadeDuration="90" android:exitFadeDuration="380">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <corners android:radius="18dp"/>
                <gradient android:angle="270" android:startColor="@color/glass_press_top" android:endColor="@color/glass_press_bottom"/>
                <stroke android:width="0.5dp" android:color="@color/glass_press_rim"/>
            </shape>
        </item>
        <item android:drawable="@android:color/transparent"/>
    </selector>
</inset>
