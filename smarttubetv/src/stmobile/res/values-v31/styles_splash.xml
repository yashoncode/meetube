<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MEETUBE(app icon): no icon of its own (@null), so the system splash shows the icon of the
         launcher alias that was tapped - the picked one on every Android version, even 12/12L,
         which can't persist a splash theme (AppIcon.syncSplash). -->
    <style name="Theme.MeeTube.Splash" parent="Theme.NewTube">
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
    </style>
    <!-- MEETUBE(launch): the Fantasy icon's splash, the painted mark beating once (Android 13+). -->
    <style name="Theme.MeeTube.Splash.Beat">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/meetube_splash_beat</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
    <!-- MEETUBE(app icon): the Classic icon's mark, still (AppIcon.syncSplash). -->
    <style name="Theme.MeeTube.Splash.Classic">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <!-- MEETUBE(app icon): the default icon (since 3.2.0) - its mark, no tile. -->
    <style name="Theme.MeeTube.Splash.White">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_fantasy</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <!-- MEETUBE(app icon): the Glass Heart icon, still. -->
    <style name="Theme.MeeTube.Splash.GlassHeart">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_glass_heart</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <!-- MEETUBE(app icon): the built-in icons from 3.2.2 - each one's shape alone, still. -->
    <style name="Theme.MeeTube.Splash.Ruby">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_ruby</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.MeeTube.Splash.Play">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_play</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.MeeTube.Splash.PlayDark">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_play_dark</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.MeeTube.Splash.Blaze">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_blaze</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
