<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass press): the chapter title on the player: nothing at rest, a lit rounded glass on a press, the same in both themes since the player stays dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="380">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#12FFFFFF"/>
            <stroke android:width="0.5dp" android:color="#40FFFFFF"/>
        </shape>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
