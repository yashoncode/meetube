<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE: a Subscriptions (Channels) list row - the sidebar's look: a white pill on focus, faint glass on the
     channel whose videos are shown, nothing otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="26dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
