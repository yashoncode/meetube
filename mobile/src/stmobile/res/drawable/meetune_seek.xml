<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUNE: the music player's thick round bars (song position, volume). The played part is
     clear here: GlowSeek draws it as a pill, so it starts round instead of as a sliver. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape>
            <size android:height="8dp" />
            <solid android:color="#40FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape>
                <size android:height="8dp" />
                <solid android:color="#00FFFFFF" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
</layer-list>
