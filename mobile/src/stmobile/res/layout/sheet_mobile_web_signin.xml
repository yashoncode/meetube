<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/mobile_web_signin_explain_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mobile_web_signin_explain_need"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mobile_web_signin_explain_current"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mobile_web_signin_explain_risk"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/web_signin_continue"
            style="@style/Widget.NewTube.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/mobile_web_signin_google" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/web_signin_not_now"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mobile_web_signin_not_now" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
