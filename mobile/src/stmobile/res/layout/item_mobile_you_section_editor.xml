<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you order): a bar-editor card with a leading grip and the existing settings switch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/mobile_settings_row_inset"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_bar_tile"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/you_section_grip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_settings_drag_handle" />

    <TextView
        android:id="@+id/settings_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="12dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp" />

    <com.newtube.mobile.ui.common.GlassSwitch
        android:id="@+id/settings_row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

</LinearLayout>
