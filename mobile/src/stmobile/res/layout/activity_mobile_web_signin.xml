<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/web_signin_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_sheet_close"
            android:padding="12dp"
            android:src="@drawable/ic_sheet_close" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="16dp"
            android:text="@string/mobile_web_signin_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:text="@string/mobile_web_signin_privacy"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/web_signin_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/web_signin_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mobile_color_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">
            <ProgressBar
                android:id="@+id/web_signin_progress"
                style="@style/Widget.MeeTube.GlassSpinner" />
            <TextView
                android:id="@+id/web_signin_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/web_signin_retry"
                style="@style/Widget.NewTube.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobile_web_signin_retry"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/web_signin_error_close"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobile_sheet_close"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
