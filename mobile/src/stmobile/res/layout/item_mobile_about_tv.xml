<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(about): the last thing on About - a look at MeeTube TV on a glass card that leans with the
     phone, its screenshot panning inside a rounded window, and a button to install it on a TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/mobile_settings_row_inset"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="@dimen/mobile_settings_row_inset"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/about_tv_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_about_tv_window">

        <ImageView
            android:id="@+id/about_tv_shot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/mobile_about_tv_shot"
            android:scaleX="1.12"
            android:scaleY="1.12"
            android:src="@drawable/about_tv_home" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/mobile_about_tv_badge"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:text="@string/mobile_about_tv_title"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/mobile_about_tv_text"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/about_tv_install"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="48dp"
        android:text="@string/mobile_about_tv_button"
        android:textAllCaps="false"
        android:textColor="@color/mobile_color_on_inverse_surface"
        app:backgroundTint="@color/mobile_color_inverse_surface"
        app:cornerRadius="28dp" />

    <!-- The repo: star it, or download the APK straight from its releases. -->
    <TextView
        android:id="@+id/about_tv_repo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/mobile_about_tv_repo"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/mobile_about_tv_repo_url"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="12sp" />
</LinearLayout>
