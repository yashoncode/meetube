<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you page): a You tile on its card: frosted glass, the frost brightest at the top and fading down, under a
     glass hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#17FFFFFF"
        android:centerColor="#0AFFFFFF"
        android:endColor="#05FFFFFF" />
    <stroke android:width="1dp" android:color="#1CFFFFFF" />
    <corners android:radius="20dp" />
</shape>
