<?xml version="1.0" encoding="utf-8"?>
<!-- An album, playlist or artist page's head: the cover across the top fading into the page, the
     name, the artist, what it is, then Add / Shuffle / Play / Find / More; Find opens the box under. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <view
        android:id="@+id/meetune_hero"
        class="com.newtube.mobile.ui.playback.MeeTunePlayerSkin$FadeImage"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/meetune_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-28dp"
        android:gravity="center"
        android:maxLines="3"
        android:paddingHorizontal="24dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meetune_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="?attr/appFontMedium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:textColor="@color/meetune_accent"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/meetune_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="?attr/appFontMedium"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:maxLines="2"
        android:paddingHorizontal="24dp"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/meetune_header_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/meetune_add"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:contentDescription="@string/meetune_save"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:glassCornerRadius="25dp"
            app:glassLiquid="true"
            app:glassTint="?attr/meetubeNavTint">

            <ImageView
                android:id="@+id/meetune_add_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_add"
                android:tint="@color/mobile_color_on_surface" />

        </com.newtube.mobile.ui.common.GlassView>

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/meetune_shuffle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:contentDescription="@string/meetune_shuffle"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:glassCornerRadius="25dp"
            app:glassLiquid="true"
            app:glassTint="?attr/meetubeNavTint">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_meetune_shuffle"
                android:tint="@color/mobile_color_on_surface" />

        </com.newtube.mobile.ui.common.GlassView>

        <FrameLayout
            android:id="@+id/meetune_play"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/meetune_play_disc"
            android:clickable="true"
            android:contentDescription="@string/meetune_play"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_meetune_play"
                android:tint="@color/mobile_color_background" />

        </FrameLayout>

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/meetune_find"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:contentDescription="@string/meetune_find"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:glassCornerRadius="25dp"
            app:glassLiquid="true"
            app:glassTint="?attr/meetubeNavTint">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_search"
                android:tint="@color/mobile_color_on_surface" />

        </com.newtube.mobile.ui.common.GlassView>

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/meetune_page_more"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:contentDescription="@string/meetune_more"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:glassCornerRadius="25dp"
            app:glassLiquid="true"
            app:glassTint="?attr/meetubeNavTint">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_meetune_more"
                android:tint="@color/mobile_color_on_surface" />

        </com.newtube.mobile.ui.common.GlassView>

    </LinearLayout>

    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/meetune_find_glass"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:glassCornerRadius="22dp"
        app:glassTint="?attr/meetubeNavTint">

        <EditText
            android:id="@+id/meetune_find_field"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/meetune_find"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textColorHint="@color/mobile_color_on_surface_secondary"
            android:textCursorDrawable="@drawable/meetube_search_cursor"
            android:textSize="16sp" />

    </com.newtube.mobile.ui.common.GlassView>

</LinearLayout>
