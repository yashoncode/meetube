<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(launch): the launch animation (LaunchSplash), the same for every app icon - a play symbol
     pops in and turns to frosted glass, in black and white (splash_* colours: black on the light theme,
     white on the dark): the solid symbol gives way to see-through glass, a milky frost, a rim and a top
     gloss, and a light sheen sweeps across it. 800 ms in all, eased so the still splash flows into it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="240"
            android:viewportHeight="240">
            <group
                android:name="play"
                android:pivotX="120"
                android:pivotY="120"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <path
                    android:name="solid"
                    android:fillColor="@color/splash_mono"
                    android:pathData="@string/splash_play_path" />
                <path
                    android:name="glass"
                    android:fillAlpha="0"
                    android:pathData="@string/splash_play_path">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:endColor="@color/splash_glass_end"
                            android:endX="168"
                            android:endY="162"
                            android:startColor="@color/splash_glass_start"
                            android:startX="96"
                            android:startY="78"
                            android:type="linear" />
                    </aapt:attr>
                </path>
                <path
                    android:name="frost"
                    android:fillAlpha="0"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="@string/splash_play_path" />
                <group android:name="inside">
                    <clip-path android:pathData="@string/splash_play_path" />
                    <path
                        android:name="gloss"
                        android:fillAlpha="0"
                        android:pathData="M90,72 H170 V118 H90 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:endColor="#00FFFFFF"
                                android:endX="0"
                                android:endY="118"
                                android:startColor="#80FFFFFF"
                                android:startX="0"
                                android:startY="78"
                                android:type="linear" />
                        </aapt:attr>
                    </path>
                    <group android:name="sheen">
                        <path
                            android:fillAlpha="0.5"
                            android:fillColor="#FFFFFFFF"
                            android:pathData="M60,60 L80,60 L56,180 L36,180 Z" />
                    </group>
                </group>
                <path
                    android:name="rim"
                    android:pathData="@string/splash_play_path"
                    android:strokeAlpha="0"
                    android:strokeColor="@color/splash_mono"
                    android:strokeLineJoin="round"
                    android:strokeWidth="2" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 0-320 ms: the solid play symbol grows in. -->
    <target android:name="play">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <!-- 200-650 ms: the solid symbol melts into glass. -->
    <target android:name="solid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="1"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="glass">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="frost">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="0.16" />
        </aapt:attr>
    </target>
    <target android:name="gloss">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="rim">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="strokeAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="0.9" />
        </aapt:attr>
    </target>
    <!-- 300-800 ms: a sheen sweeps across the glass. -->
    <target android:name="sheen">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="500"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateX"
                android:startOffset="300"
                android:valueFrom="0"
                android:valueTo="140" />
        </aapt:attr>
    </target>
</animated-vector>
