<?xml version="1.0" encoding="utf-8"?>
<!--
  Accounts bottom sheet (You tab account row) - the touch replacement for the TV
  AccountSettingsPresenter AppDialog. Two tabs on top:
  - Main accounts: every stored account (tap = switch, check = active) + "Use without account",
    then Add account / Sign out.
  - Web accounts: the optional YouTube web sign-ins (live chat, likes), then Add / Sign out.
  Rows are item_mobile_account_row / item_mobile_you_row, filled in AccountsSheet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <!-- The app's glass segmented control (Home's chips, the watch page's Up next filter). -->
        <com.newtube.mobile.ui.common.GlassChipTrack
            android:id="@+id/accounts_sheet_tabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/accounts_sheet_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/accounts_sheet_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/mobile_color_divider" />

            <LinearLayout
                android:id="@+id/accounts_sheet_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/accounts_sheet_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
