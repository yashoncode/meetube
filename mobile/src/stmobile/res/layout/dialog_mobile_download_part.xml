<?xml version="1.0" encoding="utf-8"?>
<!-- Download a part (issue #241): the start and end frames, a two-handle trim slider, and the times. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/download_part_start_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="@color/mobile_color_placeholder"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toStartOf="@id/download_part_end_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <com.newtube.mobile.ui.playback.SeekFilmstrip
            android:id="@+id/download_part_start_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/download_part_end_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        app:cardBackgroundColor="@color/mobile_color_placeholder"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/download_part_start_card"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <com.newtube.mobile.ui.playback.SeekFilmstrip
            android:id="@+id/download_part_end_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/download_part_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="-12dp"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="1"
        app:haloColor="@android:color/transparent"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_part_start_card"
        app:minSeparation="0dp"
        app:thumbColor="@color/meetube_accent"
        app:tickVisible="false"
        app:trackColorActive="@color/meetube_accent"
        app:trackColorInactive="@color/meetube_switch_off" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/download_part_start_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:hint="@string/mobile_download_part_start"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:layout_constraintEnd_toStartOf="@id/download_part_end_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_part_slider">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/download_part_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789:"
            android:imeOptions="actionNext"
            android:inputType="datetime|time"
            android:maxLines="1"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/download_part_end_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:hint="@string/mobile_download_part_end"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/download_part_start_layout"
        app:layout_constraintTop_toTopOf="@id/download_part_start_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/download_part_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789:"
            android:imeOptions="actionDone"
            android:inputType="datetime|time"
            android:maxLines="1"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/download_part_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mobile_download_part_note"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_part_start_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>
