<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE: floating sidebar glass with a static soft edge, independent of the clock pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#18000000" />
            <corners android:radius="31dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape>
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
