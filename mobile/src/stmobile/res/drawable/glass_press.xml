<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass press): a press lights a rounded glass pill inside the row (an even soft light and a
     bright hairline rim), in place of the system ripple. Theme.NewTube sets it as selectableItemBackground. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="380">
    <item android:state_pressed="true">
        <inset android:insetLeft="6dp" android:insetTop="3dp" android:insetRight="6dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp"/>
                <solid android:color="@color/glass_press_fill"/>
                <stroke android:width="0.5dp" android:color="@color/glass_press_rim"/>
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
