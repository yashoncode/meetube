    <!-- Settings: Spatial sound (issue #262) -->
    <string name="meetune_spatial">Spatial sound</string>
    <string name="meetune_spatial_off_summary">Songs as they were recorded</string>
    <string name="meetune_spatial_light">Light</string>
    <string name="meetune_spatial_light_summary">A wider stage on headphones, close to the original</string>
    <string name="meetune_spatial_strong">Strong</string>
    <string name="meetune_spatial_strong_summary">Wide and roomy, like speakers in front of you</string>
    <string name="meetune_spatial_cinema">Cinema</string>
    <string name="meetune_spatial_cinema_summary">The widest and roomiest, with a deeper bass</string>
    <string name="meetune_head_tracking">Head tracking</string>
    <string name="meetune_head_tracking_summary">The sound stays in place as you turn your head, on earbuds that track it. Starts with the next song</string>
    <string name="meetune_head_tracking_summary_none">Needs the Spatial audio of this phone: put on earbuds that support it and turn it on in their Bluetooth settings</string>
    <string name="meetune_crossfade">Crossfade</string>
    <string name="meetune_volume">Volume</string>
    <string name="meetune_volume_note">Songs only; MeeTube keeps its own Player volume. Over 100% boosts quiet songs and quiet phones. Very high levels can distort the sound or damage speakers</string>
    <string name="meetune_crossfade_off">Off</string>
    <string name="meetune_crossfade_seconds">%1$d s</string>
    <string name="meetune_automix">Automix (Beta)</string>
    <string name="meetune_automix_summary">Crossfades like a DJ: the next song comes in on the beat, its tempo matched to the playing one, then eases back to its own. Uses the Crossfade length, or 8 s when that is Off</string>
    <string name="meetune_crossfade_note">The end of a song fades into the next one. Songs from Autoplay, a queue or Repeat; not when playback stops after the song</string>
    <string name="meetune_dolby_summary">Play a song\'s Dolby Atmos or 5.1 track when YouTube has one</string>
    <string name="meetune_bit_perfect">Bit-perfect USB DAC</string>
    <string name="meetune_bit_perfect_summary">With a USB DAC plugged in, songs reach it untouched at their own sample rate, past Android\'s mixer. Starts with the next song. For a pure signal keep the equalizer flat, Spatial sound off and Volume at 100%</string>
    <string name="meetune_bit_perfect_summary_none">Needs Android 14 or later</string>
    <string name="meetune_dolby_summary_none">This phone has no Dolby decoder, so songs keep their stereo track</string>
