<?xml version="1.0" encoding="utf-8"?>
<com.newtube.mobile.ui.meetune.games.GamesPage xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/ThemeOverlay.NewTube.PlayerChrome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Out of the round to the games, or out of the games to the song. -->
        <ImageButton
            android:id="@+id/game_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/meetune_games_return_song"
            android:padding="11dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right"
            android:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/game_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="?attr/appFontMedium"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/meetune_games"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <!-- Score and Best side by side, each its label over its number. -->
        <LinearLayout
            android:id="@+id/game_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/game_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingHorizontal="6dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/game_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingHorizontal="6dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/game_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/meetune_games_pause"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_meetune_pause"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/game_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="40dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/game_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/game_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingBottom="6dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/game_field"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <!-- Paused or over: a glass card in the cover's accent over the blurred board. -->
        <FrameLayout
            android:id="@+id/game_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/game_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:minWidth="220dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">
                <TextView
                    android:id="@+id/game_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="?attr/appFontMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp" />
                <TextView
                    android:id="@+id/game_result_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/game_resume"
                        style="@style/MeeTuneGamePill"
                        android:layout_marginEnd="10dp"
                        android:text="@string/meetune_games_resume" />
                    <TextView
                        android:id="@+id/game_restart"
                        style="@style/MeeTuneGamePill"
                        android:text="@string/meetune_games_restart" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</com.newtube.mobile.ui.meetune.games.GamesPage>
