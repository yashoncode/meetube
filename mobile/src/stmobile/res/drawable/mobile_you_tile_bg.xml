<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you page): a You tile on its card, light theme: a faint grey glass fading down under a barely-there
     hairline (the dark theme's is in drawable-night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0D000000"
        android:centerColor="#08000000"
        android:endColor="#05000000" />
    <stroke android:width="1dp" android:color="#0D000000" />
    <corners android:radius="20dp" />
</shape>
