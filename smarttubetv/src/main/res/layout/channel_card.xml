<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: You can't set layout dimension for Presenter's container -->
<!-- MEETUBE: a glass pill - round avatar, name, a red dot for new videos (ChannelCardPresenter) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:focusableInTouchMode="true"
             android:focusable="true"
             android:background="@drawable/channel_glass_pill"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content">
    <LinearLayout
                  android:id="@+id/channel_card_wrapper"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:paddingStart="6dp"
                  android:paddingEnd="14dp"
                  android:paddingTop="6dp"
                  android:paddingBottom="6dp"
                  android:layout_width="@dimen/channel_card_width"
                  android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/channel_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"/>
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
            android:id="@+id/channel_title"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="15sp"
            android:textAlignment="textStart"/>
        <View
            android:id="@+id/channel_new_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/channel_new_dot"
            android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
