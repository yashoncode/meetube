<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass press): Subscribe: the solid main action pill; Subscribed (selected) a glass pill. Either lit like glass on a press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/meetube_glass_fill"/>
                        <stroke android:width="0.5dp" android:color="@color/meetube_glass_stroke"/>
                        <corners android:radius="20dp"/>
                    </shape>
                </item>
                <item>
                    <selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="380">
                        <item android:state_pressed="true">
                            <shape android:shape="rectangle">
                                <corners android:radius="20dp"/>
                                <gradient android:angle="270" android:startColor="@color/glass_press_top" android:endColor="@color/glass_press_bottom"/>
                                <stroke android:width="0.5dp" android:color="@color/glass_press_rim"/>
                            </shape>
                        </item>
                        <item android:drawable="@android:color/transparent"/>
                    </selector>
                </item>
            </layer-list>
        </inset>
    </item>
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/mobile_color_inverse_surface"/>
                        <corners android:radius="20dp"/>
                    </shape>
                </item>
                <item>
                    <selector android:enterFadeDuration="90" android:exitFadeDuration="380">
                        <item android:state_pressed="true">
                            <shape android:shape="rectangle">
                                <corners android:radius="20dp"/>
                                <gradient android:angle="270" android:startColor="@color/glass_press_inverse_top" android:endColor="@color/glass_press_inverse_bottom"/>
                                <stroke android:width="0.5dp" android:color="@color/glass_press_inverse_rim"/>
                            </shape>
                        </item>
                        <item android:drawable="@android:color/transparent"/>
                    </selector>
                </item>
            </layer-list>
        </inset>
    </item>
</selector>
