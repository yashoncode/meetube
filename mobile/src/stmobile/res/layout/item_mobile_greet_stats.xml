<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(stats): the greeting's glass card of time spent - today, the last 7 days and videos
     today, the last 7 days as bars (today's in full accent), and watch time and the daily average. -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:glassCornerRadius="24dp"
    app:glassOnGlass="true"
    app:glassTint="@color/meetube_glass_tint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/stats_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/stats_bars"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/stats_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/stats_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="@string/mobile_stats_on_device"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</com.newtube.mobile.ui.common.GlassView>
