<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(focus): the greeting's Focus pill (FocusTimer). The label picks the minutes, the round
     button starts or stops; running, the label counts down. -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="230dp"
    android:layout_height="52dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="12dp"
    android:clickable="true"
    app:glassCornerRadius="26dp"
    app:glassOnGlass="true"
    app:glassTint="@color/meetube_greet_glass_tint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_mobile_focus_timer"
            android:drawablePadding="16dp"
            android:drawableTint="@color/mobile_color_on_surface"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            tools:text="Focus · 25 min" />

        <ImageButton
            android:id="@+id/focus_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_play"
            app:tint="@color/mobile_color_on_surface" />

    </LinearLayout>

</com.newtube.mobile.ui.common.GlassView>
