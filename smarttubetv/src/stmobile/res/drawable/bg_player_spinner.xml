<?xml version="1.0" encoding="utf-8"?>
<!-- METUBE(issue #77): the loading spinner's glass disc - a dim base so the arc reads on any
     frame, a frosted white tint, a soft highlight on top and a hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#47000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="0.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
