    <string name="meetune_spatial_wide_summary">Trong trẻo và thoáng rộng, tách kênh stereo nhẹ kết hợp trộn âm chéo (crossfeed)</string>
    <string name="meetune_head_tracking">Theo dõi chuyển động đầu</string>
    <string name="meetune_head_tracking_summary">Âm thanh giữ nguyên vị trí khi bạn xoay đầu, trên các tai nghe có hỗ trợ tính năng này. Áp dụng từ bài tiếp theo</string>
    <string name="meetune_head_tracking_summary_none">Cần Âm thanh không gian của điện thoại: hãy đeo tai nghe có hỗ trợ và bật tính năng này trong phần cài đặt Bluetooth của tai nghe</string>
    <string name="meetune_crossfade">Crossfade (Chuyển bài mượt)</string>
    <string name="meetune_volume">Âm lượng</string>
    <string name="meetune_volume_note" formatted="false">Chỉ áp dụng cho bài hát; MeeTube giữ riêng mức Âm lượng trình phát. Mức trên 100% giúp tăng âm lượng cho các bài hát nhỏ hoặc điện thoại loa nhỏ. Mức quá cao có thể làm méo tiếng hoặc hỏng loa</string>
    <string name="meetune_crossfade_off">Tắt</string>
    <string name="meetune_crossfade_seconds">%1$d giây</string>
    <string name="meetune_automix">MeeTuneMix</string>
    <string name="meetune_automix_summary">Chuyển bài như DJ: bài tiếp theo vào đúng nhịp, đồng bộ tốc độ với bài đang phát rồi dần trở về nhịp gốc. Dùng thời lượng Crossfade, hoặc 8 giây nếu đang tắt</string>
    <string name="meetune_crossfade_note">Cuối bài hát sẽ nhỏ dần và hòa sang bài kế tiếp. Áp dụng cho Tự động phát, hàng chờ hoặc Lặp lại; không áp dụng khi nhạc dừng sau khi hết bài</string>
    <string name="meetune_bit_perfect">Bit-perfect USB DAC</string>
    <string name="meetune_bit_perfect_summary">Khi cắm USB DAC, bài hát được truyền nguyên bản theo đúng tần số lấy mẫu gốc, bỏ qua bộ trộn của Android. Áp dụng từ bài tiếp theo. Để tín hiệu thuần khiết, hãy giữ bộ chỉnh âm phẳng, tắt Âm thanh không gian và đặt Âm lượng MeeTune ở mức 100%</string>
    <string name="meetune_bit_perfect_summary_none">Yêu cầu Android 14 trở lên</string>
