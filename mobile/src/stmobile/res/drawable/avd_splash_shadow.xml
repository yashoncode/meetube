<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(launch): a solid red play with a glass copy that slides out behind it, down and right. 480 ms in all (LaunchSplash). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="240"
            android:viewportHeight="240">
            <group android:name="ghost" android:pivotX="128" android:pivotY="120" android:translateX="-8"
                android:scaleX="0.72" android:scaleY="0.72">
                <path android:name="ghost_path" android:pathData="@string/splash_play_path" android:fillAlpha="0"
                    android:strokeAlpha="0" android:strokeWidth="1.6" android:strokeLineJoin="round">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="96" android:startY="78" android:endX="168" android:endY="162"
                            android:startColor="@color/splash_tile_top" android:endColor="@color/splash_tile_bottom" />
                    </aapt:attr>
                    <aapt:attr name="android:strokeColor">
                        <gradient android:type="linear" android:startX="96" android:startY="78" android:endX="168" android:endY="162">
                            <item android:color="@color/splash_rim_lit" android:offset="0" />
                            <item android:color="@color/splash_rim_dim" android:offset="0.55" />
                            <item android:color="@color/splash_rim_far" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <group android:name="play" android:pivotX="128" android:pivotY="120" android:translateX="-8"
                android:scaleX="0.72" android:scaleY="0.72">
                <path android:name="play_path" android:pathData="@string/splash_play_path" android:fillAlpha="0"
                    android:fillColor="#FFFF453A" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ghost">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateX"
                android:startOffset="120"
                android:valueFrom="-8"
                android:valueTo="-1" />
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateY"
                android:startOffset="120"
                android:valueFrom="0"
                android:valueTo="7" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ghost_path">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="120"
                android:valueFrom="0"
                android:valueTo="1" />
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="strokeAlpha"
                android:startOffset="120"
                android:valueFrom="0"
                android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="play">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX"
                android:valueFrom="0.432"
                android:valueTo="0.72" />
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY"
                android:valueFrom="0.432"
                android:valueTo="0.72" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="play_path">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
