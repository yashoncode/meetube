<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(launch): the launch animation (LaunchSplash), the same for every app icon - a rounded glass
     tile settles in, the red play pops inside it and a light sheen crosses the glass. 480 ms in all. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="240"
            android:viewportHeight="240">
            <group
                android:name="tile_group"
                android:pivotX="120"
                android:pivotY="120"
                android:scaleX="0.86"
                android:scaleY="0.86">
                <path
                    android:name="tile"
                    android:fillAlpha="0"
                    android:pathData="@string/splash_tile_path"
                    android:strokeAlpha="0"
                    android:strokeWidth="1.2">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:endColor="@color/splash_tile_bottom"
                            android:endX="176"
                            android:endY="176"
                            android:startColor="@color/splash_tile_top"
                            android:startX="64"
                            android:startY="64"
                            android:type="linear" />
                    </aapt:attr>
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:endX="176"
                            android:endY="176"
                            android:startX="64"
                            android:startY="64"
                            android:type="linear">
                            <item android:color="@color/splash_rim_lit" android:offset="0" />
                            <item android:color="@color/splash_rim_dim" android:offset="0.55" />
                            <item android:color="@color/splash_rim_far" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <!-- The play symbol at half size, its optical centre (128,120) moved to the tile's centre. -->
            <group
                android:name="play"
                android:pivotX="128"
                android:pivotY="120"
                android:scaleX="0.3"
                android:scaleY="0.3"
                android:translateX="-8">
                <path
                    android:name="play_path"
                    android:fillAlpha="0"
                    android:fillColor="#FFFF453A"
                    android:pathData="@string/splash_play_path" />
            </group>
            <group android:name="glass">
                <clip-path android:pathData="@string/splash_tile_path" />
                <group android:name="sheen">
                    <path android:pathData="M8.5,40 L38.5,40 L-7.4,200 L-37.4,200 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:endX="38.5"
                                android:endY="120"
                                android:startX="-37.4"
                                android:startY="120"
                                android:type="linear">
                                <item android:color="#00FFFFFF" android:offset="0" />
                                <item android:color="@color/splash_sheen" android:offset="0.5" />
                                <item android:color="#00FFFFFF" android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 0-280 ms: the tile settles in. -->
    <target android:name="tile_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.86"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.86"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="tile">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <!-- 110-350 ms: the play pops in. -->
    <target android:name="play">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="110"
                    android:valueFrom="0.3"
                    android:valueTo="0.5" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="110"
                    android:valueFrom="0.3"
                    android:valueTo="0.5" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="play_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="240"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="110"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <!-- 160-480 ms: a sheen crosses the glass. -->
    <target android:name="sheen">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateX"
                android:startOffset="160"
                android:valueFrom="0"
                android:valueTo="260" />
        </aapt:attr>
    </target>
</animated-vector>
