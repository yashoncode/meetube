<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(you page): a You tile on its card: frosted glass, the frost brightest at the top and fading down, under a
     glass hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0CFFFFFF"
        android:centerColor="#06FFFFFF"
        android:endColor="#03FFFFFF" />
    <stroke android:width="1dp" android:color="#0AFFFFFF" />
    <corners android:radius="20dp" />
</shape>
