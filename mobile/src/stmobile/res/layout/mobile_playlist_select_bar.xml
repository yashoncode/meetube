<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(playlist page): Select videos' bar, frosted glass like the nav pill (PlaylistSelection fills the row). -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="16dp"
    android:elevation="6dp"
    app:glassCornerRadius="34dp"
    app:glassTint="@color/meetube_glass_tint">

    <LinearLayout
        android:id="@+id/mobile_playlist_select_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp" />

</com.newtube.mobile.ui.common.GlassView>
